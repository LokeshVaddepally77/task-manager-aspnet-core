<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Task Manager</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/task-styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var isLoggedIn = !string.IsNullOrEmpty(Context.Session.GetString("Username"));
        var username = Context.Session.GetString("Username");
        var role = Context.Session.GetString("Role");
        var fullName = Context.Session.GetString("FullName") ?? username;
        var isManager = role == "Manager";
        var isGoogleUser = !string.IsNullOrEmpty(Context.Session.GetString("GoogleId"));
        var loginMethod = Context.Session.GetString("LoginMethod");
    }

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
            <div class="container-fluid">
                <!-- Brand -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Task" asp-action="Dashboard">
                    <i class="bi bi-clipboard-check me-2"></i>
                    <span class="fw-bold">Task Manager</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Content -->
                <div class="collapse navbar-collapse" id="mainNavbar">
                    @if (isLoggedIn)
                    {
                        <!-- Left Navigation -->
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Task" asp-action="Dashboard">
                                    <i class="bi bi-speedometer2"></i> Dashboard
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Task" asp-action="MyTasks">
                                    <i class="bi bi-list-check"></i> My Tasks
                                </a>
                            </li>

                            @* Manager Only: All Tasks *@
                            @if (isManager)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Task" asp-action="Index">
                                        <i class="bi bi-kanban"></i> All Tasks
                                    </a>
                                </li>
                            }

                            @* Manager Only: Create Task *@
                            @if (isManager)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Task" asp-action="Create">
                                        <i class="bi bi-plus-circle"></i> Create Task
                                    </a>
                                </li>
                            }

                            @* Manager Only: Team *@
                            @if (isManager)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Team" asp-action="Index">
                                        <i class="bi bi-people"></i> Team
                                    </a>
                                </li>
                            }
                            @if (isManager)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Role" asp-action="Index">
                                        <i class="bi bi-shield-lock"></i> Role Management
                                    </a>
                                </li>
                            }
                        </ul>

                        <!-- Right Navigation - User Menu -->
                        <ul class="navbar-nav">
                            <!-- Role Badge -->
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="badge @(isManager ? "bg-warning text-dark" : "bg-light text-dark")">
                                    <i class="bi @(isManager ? "bi-star-fill" : "bi-person")"></i>
                                    @role
                                </span>
                                @* NEW: Google Badge *@
                                @if (isGoogleUser)
                                {
                                    <span class="badge bg-danger ms-2" title="Logged in with Google">
                                        <i class="bi bi-google"></i>
                                    </span>
                                }
                            </li>

                            <!-- User Dropdown -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#"
                                   id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <div class="rounded-circle bg-white text-primary d-flex justify-content-center align-items-center me-2"
                                         style="width: 32px; height: 32px; font-size: 14px;">
                                        @username![0].ToString().ToUpper()
                                    </div>
                                    <span>@fullName</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <!-- User Info Header -->
                                    <li>
                                        <div class="dropdown-item-text bg-light">
                                            <div class="d-flex align-items-center">
                                                <div class="rounded-circle bg-primary text-white d-flex justify-content-center align-items-center me-2"
                                                     style="width: 40px; height: 40px;">
                                                    @username![0].ToString().ToUpper()
                                                </div>
                                                <div>
                                                    <div class="fw-bold">@fullName</div>
                                                    <small class="text-muted">@username</small>
                                                </div>
                                            </div>
                                        </div>
                                    </li>

                                    @* NEW: Show email if available *@
                                    @if (!string.IsNullOrEmpty(Context.Session.GetString("Email")))
                                    {
                                        <li>
                                            <div class="dropdown-item-text">
                                                <small class="text-muted">
                                                    <i class="bi bi-envelope"></i> @Context.Session.GetString("Email")
                                                </small>
                                            </div>
                                        </li>
                                    }

                                    @* NEW: Show login method *@
                                    @if (isGoogleUser && !string.IsNullOrEmpty(loginMethod))
                                    {
                                        <li>
                                            <div class="dropdown-item-text">
                                                <small class="text-muted">
                                                    <i class="bi bi-key"></i> Logged in via @loginMethod
                                                </small>
                                            </div>
                                        </li>
                                    }

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person-circle me-2"></i> My Profile
                                        </a>
                                    </li>

                                    @* UPDATED: Hide Change Password for Google users *@
                                    @if (!isGoogleUser)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">
                                                <i class="bi bi-key me-2"></i> Change Password
                                            </a>
                                        </li>
                                    }

                                    @if (isManager)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="CreateUser">
                                                <i class="bi bi-person-plus me-2"></i> Create User
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">
                                                <i class="bi bi-box-arrow-right me-2"></i> Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <!-- Not Logged In -->
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus"></i> Register
                                </a>
                            </li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid py-4">
        <main role="main">
            <!-- Global Success/Error Messages -->
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle"></i> @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    &copy; 2025 - Task Manager MVC
                </div>
                <div class="col-md-6 text-md-end">
                    <small>INFO 6250 - Web Development</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

<style>
    .dropdown-menu {
        min-width: 280px;
    }

    .dropdown-item-text {
        white-space: normal;
    }
</style>