@using TaskManagerMVC.DataAccess.Models
@model TaskItem

@{
    ViewData["Title"] = "Edit Task";
    var users = ViewBag.Users as List<ApplicationUser> ?? new List<ApplicationUser>();
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var tags = ViewBag.Tags as List<Tag> ?? new List<Tag>();
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm mb-3">
                <i class="bi bi-arrow-left"></i> Back
            </a>
            <h2 class="mb-1">
                <i class="bi bi-pencil-square"></i> Edit Task
            </h2>
        </div>
    </div>

    <div class="row">
        <!-- Left Column - Form (8 cols) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-controller="Task" asp-action="Edit" asp-route-id="@Model.TaskId" method="post">
                        @Html.AntiForgeryToken()

                        <!-- Hidden ID -->
                        <input type="hidden" asp-for="TaskId" />
                        <input type="hidden" asp-for="CreatedById" />
                        <input type="hidden" asp-for="CreatedDate" />

                        <!-- Task Title -->
                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">Task Title <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter task title" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-bold">Description <span class="text-danger">*</span></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Enter description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Priority and Status -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Priority" class="form-label fw-bold">Priority <span class="text-danger">*</span></label>
                                <select asp-for="Priority" class="form-select">
                                    <option value="">-- Select --</option>
                                    <option value="Low">Low</option>
                                    <option value="Medium">Medium</option>
                                    <option value="High">High</option>
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-bold">Status <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select">
                                    <option value="">-- Select --</option>
                                    <option value="New">New</option>
                                    <option value="In Progress">In Progress</option>
                                    <option value="Completed">Completed</option>
                                    <option value="On Hold">On Hold</option>
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Category and Assigned To -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="CategoryId" class="form-label fw-bold">Category</label>
                                <select asp-for="CategoryId" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var category in categories)
                                    {
                                        <option value="@category.CategoryId">@category.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <!-- UPDATED: Using Identity properties (Id and UserName) -->
                                <label asp-for="AssignedToId" class="form-label fw-bold">Assigned To <span class="text-danger">*</span></label>
                                <select asp-for="AssignedToId" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var user in users)
                                    {
                                        <option value="@user.Id">@user.FullName (@user.UserName)</option>
                                    }
                                </select>
                                <span asp-validation-for="AssignedToId" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Due Date -->
                        <div class="mb-3">
                            <label asp-for="DueDate" class="form-label fw-bold">Due Date <span class="text-danger">*</span></label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>

                        <!-- Tags (Display Only - as comma-separated string) -->
                        <div class="mb-3">
                            <label class="form-label fw-bold">Tags</label>
                            <div class="form-control bg-light">
                                @if (Model.TaskTags != null && Model.TaskTags.Any())
                                {
                                    @string.Join(", ", Model.TaskTags.Select(tt => tt.Tag?.Name ?? ""))
                                }
                                else
                                {
                                    <span class="text-muted">No tags assigned</span>
                                }
                            </div>
                            <small class="text-muted">Tags can be managed from task details page</small>
                        </div>

                        <!-- Completion Percentage -->
                        <div class="mb-4">
                            <label asp-for="CompletionPercentage" class="form-label fw-bold">Completion %</label>
                            <div class="d-flex gap-3 align-items-center">
                                <input asp-for="CompletionPercentage" type="range" class="form-range"
                                       min="0" max="100" id="completionSlider" />
                                <span id="percentageValue" class="badge bg-primary">@Model.CompletionPercentage%</span>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Save Changes
                            </button>
                            <a asp-controller="Task" asp-action="Details" asp-route-id="@Model.TaskId"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Right Column - Info (4 cols) -->
        <div class="col-lg-4">
            <!-- Current Info Card -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Current Information</h5>
                </div>
                <div class="card-body p-4">
                    <div class="mb-3">
                        <h6 class="text-muted">Task ID</h6>
                        <p>#@Model.TaskId</p>
                    </div>
                    <div class="mb-3">
                        <h6 class="text-muted">Created By</h6>
                        <p>@Model.CreatedBy</p>
                    </div>
                    <div class="mb-3">
                        <h6 class="text-muted">Created Date</h6>
                        <p>@Model.CreatedDate.ToString("MMM dd, yyyy")</p>
                    </div>
                    <div>
                        <h6 class="text-muted">Last Modified</h6>
                        <p>@Model.LastModifiedDate.ToString("MMM dd, yyyy")</p>
                    </div>
                </div>
            </div>

            <!-- Tips Card -->
            <div class="card border-0 shadow-sm"
                 style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <div class="card-body p-4">
                    <h6 class="mb-3">
                        <i class="bi bi-lightbulb"></i> Tips
                    </h6>
                    <ul class="small mb-0">
                        <li class="mb-2">Use clear task titles</li>
                        <li class="mb-2">Update priority as needed</li>
                        <li class="mb-2">Track completion percentage</li>
                        <li>Update status regularly</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('completionSlider')?.addEventListener('input', function() {
            document.getElementById('percentageValue').textContent = this.value + '%';
        });
    </script>
}