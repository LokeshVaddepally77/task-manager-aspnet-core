@using TaskManagerMVC.DataAccess.Models
@model List<TaskItem>

@{
    ViewData["Title"] = "All Tasks";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-lg-8">
            <h2 class="fw-bold">
                <i class="bi bi-kanban"></i> All Tasks
            </h2>
            <p class="text-muted">Complete overview of all team tasks</p>
        </div>
        <div class="col-lg-4 text-end">
            <!-- Create New Task Button using Anchor Tag Helper -->
            <a asp-controller="Task" asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Create Task
            </a>
        </div>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-2">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body">
                    <h6 class="text-muted">Total Tasks</h6>
                    <h3 class="fw-bold">@Model.Count</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body">
                    <h6 class="text-muted">Completed</h6>
                    <h3 class="fw-bold text-success">@Model.Count(t => t.Status == "Completed")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body">
                    <h6 class="text-muted">In Progress</h6>
                    <h3 class="fw-bold text-info">@Model.Count(t => t.Status == "In Progress")</h3>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-2">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-body">
                    <h6 class="text-muted">Overdue</h6>
                    <h3 class="fw-bold text-danger">@Model.Count(t => t.DueDate < DateTime.Now && t.Status != "Completed")</h3>
                </div>
            </div>
        </div>
    </div>

    <!-- Tasks Table -->
    @if (Model.Count == 0)
    {
        <div class="alert alert-info text-center py-5">
            <i class="bi bi-inbox"></i>
            <h5>No tasks yet</h5>
            <p>Start by creating your first task.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Assigned To</th>
                            <th>Category</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Progress</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var task in Model)
                        {
                            <tr>
                                <td class="fw-bold">@task.Title</td>
                                <td>@task.AssignedTo</td>
                                <td>
                                    <span class="badge bg-light text-dark">@task.CategoryName</span>
                                </td>
                                <td>
                                    <!-- ENHANCED: Using custom Priority Badge Tag Helper -->
                                    <priority-badge priority="@task.Priority"></priority-badge>
                                </td>
                                <td>
                                    <!-- ENHANCED: Using custom Status Badge Tag Helper -->
                                    <status-badge status="@task.Status"></status-badge>
                                </td>
                                <td>
                                    @if (task.DueDate < DateTime.Now && task.Status != "Completed")
                                    {
                                        <span class="text-danger fw-bold">@task.DueDate.ToString("MMM dd")</span>
                                    }
                                    else
                                    {
                                        <span>@task.DueDate.ToString("MMM dd")</span>
                                    }
                                </td>
                                <td>
                                    <!-- ENHANCED: Using custom Progress Bar Tag Helper -->
                                    <progress-bar percentage="@task.CompletionPercentage"
                                                  height="20px"
                                                  show-label="true">
                                    </progress-bar>
                                </td>
                                <td>
                                    <!-- View using Anchor Tag Helper -->
                                    <a asp-controller="Task" asp-action="Details" asp-route-id="@task.TaskId"
                                       class="btn btn-sm btn-outline-primary" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <!-- Edit using Anchor Tag Helper -->
                                    <a asp-controller="Task" asp-action="Edit" asp-route-id="@task.TaskId"
                                       class="btn btn-sm btn-outline-secondary" title="Edit Task">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
