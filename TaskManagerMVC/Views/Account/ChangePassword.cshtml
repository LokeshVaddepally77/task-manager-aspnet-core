@model TaskManagerMVC.DataAccess.ViewModels.ChangePasswordViewModel

@{
    ViewData["Title"] = "Change Password";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-md-6">
            <div class="card border-0 shadow-lg">
                <div class="card-header text-white text-center py-4"
                     style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);">
                    <h3 class="mb-0">
                        <i class="bi bi-key"></i> Change Password
                    </h3>
                    <p class="mb-0 mt-2 opacity-75">Update your account password</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="ChangePassword" asp-controller="Account" method="post">
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Current Password -->
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-bold">
                                <i class="bi bi-lock"></i> Current Password <span class="text-danger">*</span>
                            </label>
                            <input asp-for="CurrentPassword" class="form-control" />
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <!-- New Password -->
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold">
                                <i class="bi bi-lock-fill"></i> New Password <span class="text-danger">*</span>
                            </label>
                            <input asp-for="NewPassword" class="form-control" />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                            <small class="text-muted">Minimum 6 characters</small>
                        </div>

                        <!-- Confirm New Password -->
                        <div class="mb-4">
                            <label asp-for="ConfirmNewPassword" class="form-label fw-bold">
                                <i class="bi bi-lock-fill"></i> Confirm New Password <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ConfirmNewPassword" class="form-control" />
                            <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Update Password
                            </button>
                            <a asp-action="Profile" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}