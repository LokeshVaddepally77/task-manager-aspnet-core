@model TaskManagerMVC.DataAccess.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Create User";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-center mt-4">
        <div class="col-md-7">
            <div class="card border-0 shadow-lg">
                <div class="card-header text-white text-center py-4"
                     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h3 class="mb-0">
                        <i class="bi bi-person-plus-fill"></i> Create New User
                    </h3>
                    <p class="mb-0 mt-2 opacity-75">Add a new team member (Manager Only)</p>
                </div>

                <div class="card-body p-4">
                    <form asp-action="CreateUser" asp-controller="Account" method="post">
                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Name Row -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label fw-bold">
                                    <i class="bi bi-person"></i> First Name
                                </label>
                                <input asp-for="FirstName" class="form-control" placeholder="John" />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label fw-bold">
                                    <i class="bi bi-person"></i> Last Name
                                </label>
                                <input asp-for="LastName" class="form-control" placeholder="Doe" />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Username Field -->
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold">
                                <i class="bi bi-at"></i> Username <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Username" class="form-control" placeholder="johndoe" />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Email Field -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold">
                                <i class="bi bi-envelope"></i> Email Address <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="john@company.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Role Selection (Manager can set role) -->
                        <div class="mb-3">
                            <label asp-for="Role" class="form-label fw-bold">
                                <i class="bi bi-shield"></i> User Role <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Role" class="form-select">
                                <option value="Employee">Employee</option>
                                <option value="Manager">Manager</option>
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                            <small class="text-muted">
                                <strong>Employee:</strong> Can view and update their own tasks<br>
                                <strong>Manager:</strong> Full access to create tasks, manage team
                            </small>
                        </div>

                        <!-- Password Field -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">
                                <i class="bi bi-lock"></i> Initial Password <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Password" class="form-control" placeholder="Minimum 6 characters" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password Field -->
                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold">
                                <i class="bi bi-lock-fill"></i> Confirm Password <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Re-enter password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-person-plus"></i> Create User
                            </button>
                            <a asp-controller="Team" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}