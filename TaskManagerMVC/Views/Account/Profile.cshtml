@model TaskManagerMVC.DataAccess.ViewModels.UserProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- Page Header -->
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="fw-bold">
                <i class="bi bi-person-circle"></i> My Profile
            </h2>
            <p class="text-muted">Manage your account settings</p>
        </div>
    </div>

    <!-- Success Message -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Left Column - Profile Info -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-person-badge"></i> Profile Information
                    </h5>
                </div>
                <div class="card-body p-4">
                    <!-- Avatar and Name -->
                    <div class="d-flex align-items-center mb-4">
                        <div class="rounded-circle d-flex justify-content-center align-items-center me-3"
                             style="width: 80px; height: 80px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; font-size: 2rem;">
                            @Model.Username[0].ToString().ToUpper()
                        </div>
                        <div>
                            <h4 class="mb-1">
                                @(string.IsNullOrEmpty(Model.FirstName) ? Model.Username : $"{Model.FirstName} {Model.LastName}")
                            </h4>
                            <span class="badge @(Model.Role == "Manager" ? "bg-primary" : "bg-secondary")">
                                @Model.Role
                            </span>
                        </div>
                    </div>

                    <hr>

                    <!-- Profile Details -->
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted">Username</label>
                            <p class="mb-0">@@@Model.Username</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted">Email</label>
                            <p class="mb-0">@Model.Email</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted">First Name</label>
                            <p class="mb-0">@(Model.FirstName ?? "Not set")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted">Last Name</label>
                            <p class="mb-0">@(Model.LastName ?? "Not set")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted">Account Created</label>
                            <p class="mb-0">@Model.CreatedDate.ToString("MMMM dd, yyyy")</p>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted">Last Login</label>
                            <p class="mb-0">
                                @(Model.LastLoginDate.HasValue? Model.LastLoginDate.Value.ToString("MMMM dd, yyyy HH:mm") : "Never")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Task Statistics -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom">
                    <h5 class="mb-0 fw-bold">
                        <i class="bi bi-bar-chart"></i> My Task Statistics
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row text-center">
                        <div class="col-md-3 mb-3">
                            <div class="p-3 rounded" style="background-color: #e3f2fd;">
                                <h3 class="text-primary mb-1">@Model.TotalTasks</h3>
                                <small class="text-muted">Total Tasks</small>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="p-3 rounded" style="background-color: #e8f5e9;">
                                <h3 class="text-success mb-1">@Model.CompletedTasks</h3>
                                <small class="text-muted">Completed</small>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="p-3 rounded" style="background-color: #e0f7fa;">
                                <h3 class="text-info mb-1">@Model.InProgressTasks</h3>
                                <small class="text-muted">In Progress</small>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="p-3 rounded" style="background-color: #fff3e0;">
                                <h3 class="text-warning mb-1">@Model.CompletionRate.ToString("F1")%</h3>
                                <small class="text-muted">Completion Rate</small>
                            </div>
                        </div>
                    </div>

                    <!-- Progress Bar -->
                    <div class="mt-3">
                        <label class="form-label fw-bold">Overall Progress</label>
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar bg-success" role="progressbar"
                                 style="width: @Model.CompletionRate%"
                                 aria-valuenow="@Model.CompletionRate" aria-valuemin="0" aria-valuemax="100">
                                @Model.CompletionRate.ToString("F1")%
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column - Quick Actions -->
        <div class="col-lg-4">
            <!-- Account Actions -->
            <div class="card border-0 shadow-sm mb-4"
                 style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <div class="card-body p-4">
                    <h5 class="mb-3">
                        <i class="bi bi-gear"></i> Account Actions
                    </h5>
                    <div class="d-grid gap-2">
                        <a asp-action="ChangePassword" class="btn btn-light btn-sm">
                            <i class="bi bi-key"></i> Change Password
                        </a>
                        <a asp-controller="Task" asp-action="Dashboard" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-speedometer2"></i> Go to Dashboard
                        </a>
                        <a asp-controller="Task" asp-action="MyTasks" class="btn btn-outline-light btn-sm">
                            <i class="bi bi-list-check"></i> View My Tasks
                        </a>
                    </div>
                </div>
            </div>

            <!-- Role Information -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-light">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-shield-check"></i> Role Permissions
                    </h6>
                </div>
                <div class="card-body">
                    @if (Model.Role == "Manager")
                    {
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Create & Assign Tasks</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> View All Team Tasks</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Manage Team Members</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Create New Users</li>
                            <li><i class="bi bi-check-circle text-success"></i> View Team Statistics</li>
                        </ul>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> View Personal Dashboard</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> View Assigned Tasks</li>
                            <li class="mb-2"><i class="bi bi-check-circle text-success"></i> Update Task Progress</li>
                            <li class="mb-2"><i class="bi bi-x-circle text-danger"></i> Create New Tasks</li>
                            <li><i class="bi bi-x-circle text-danger"></i> Manage Team</li>
                        </ul>
                    }
                </div>
            </div>
        </div>
    </div>
</div>