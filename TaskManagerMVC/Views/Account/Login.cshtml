@model TaskManagerMVC.DataAccess.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg">
                <!-- Card Header with Gradient -->
                <div class="card-header text-white text-center py-4"
                     style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                    <h3 class="mb-0">
                        <i class="bi bi-clipboard-check"></i> Task Manager
                    </h3>
                    <p class="mb-0 mt-2 opacity-75">Sign in to your account</p>
                </div>

                <div class="card-body p-4">
                    <!-- Success Message -->
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle"></i> @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Error Message -->
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-circle"></i> @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Login Form -->
                    <form asp-action="Login" asp-controller="Account" method="post">
                        <input type="hidden" asp-for="ReturnUrl" />

                        <!-- Validation Summary -->
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Username Field -->
                        <div class="mb-3">
                            <label asp-for="Username" class="form-label fw-bold">
                                <i class="bi bi-person"></i> Username
                            </label>
                            <input asp-for="Username" class="form-control form-control-lg"
                                   placeholder="Enter your username" autofocus />
                            <span asp-validation-for="Username" class="text-danger small"></span>
                        </div>

                        <!-- Password Field -->
                        <div class="mb-3">
                            <label asp-for="Password" class="form-label fw-bold">
                                <i class="bi bi-lock"></i> Password
                            </label>
                            <div class="input-group">
                                <input asp-for="Password" class="form-control form-control-lg"
                                       placeholder="Enter your password" id="passwordInput" />
                                <button class="btn btn-outline-secondary" type="button"
                                        onclick="togglePassword()">
                                    <i class="bi bi-eye" id="toggleIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Remember Me -->
                        <div class="mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" />
                                <label asp-for="RememberMe" class="form-check-label">
                                    Remember me
                                </label>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-box-arrow-in-right"></i> Sign In
                            </button>
                        </div>
                    </form>

                    <!-- Divider with OR -->
                    <div class="position-relative my-4">
                        <hr class="text-muted">
                        <span class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted fw-bold">
                            OR
                        </span>
                    </div>

                    <!-- NEW: Google Login Button -->
                    <div class="d-grid mb-4">
                        <a asp-action="GoogleLogin"
                           asp-controller="Account"
                           asp-route-returnUrl="@ViewData["ReturnUrl"]"
                           class="btn btn-outline-danger btn-lg d-flex align-items-center justify-content-center">
                            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="me-2" viewBox="0 0 16 16">
                                <path d="M15.545 6.558a9.42 9.42 0 0 1 .139 1.626c0 2.434-.87 4.492-2.384 5.885h.002C11.978 15.292 10.158 16 8 16A8 8 0 1 1 8 0a7.689 7.689 0 0 1 5.352 2.082l-2.284 2.284A4.347 4.347 0 0 0 8 3.166c-2.087 0-3.86 1.408-4.492 3.304a4.792 4.792 0 0 0 0 3.063h.003c.635 1.893 2.405 3.301 4.492 3.301 1.078 0 2.004-.276 2.722-.764h-.003a3.702 3.702 0 0 0 1.599-2.431H8v-3.08h7.545z" />
                            </svg>
                            Sign in with Google
                        </a>
                    </div>

                    <!-- Register Link -->
                    <div class="text-center">
                        <p class="mb-0">
                            Don't have an account?
                            <a asp-action="Register" asp-controller="Account" class="text-primary fw-bold">
                                Create Account
                            </a>
                        </p>
                    </div>
                </div>

                <!-- Demo Credentials -->
                <div class="card-footer bg-light">
                    <div class="small text-muted">
                        <strong>Demo Credentials:</strong>
                        <div class="row mt-2">
                            <div class="col-6">
                                <span class="badge bg-primary">Manager</span><br>
                                <code>Sarah / password123</code>
                            </div>
                            <div class="col-6">
                                <span class="badge bg-secondary">Employee</span><br>
                                <code>John / password123</code>
                            </div>
                        </div>
                        <div class="mt-2 pt-2 border-top">
                            <small><i class="bi bi-info-circle"></i> Or sign in with your Google account</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Security Notice -->
            <div class="text-center mt-3">
                <small class="text-muted">
                    <i class="bi bi-shield-check"></i>
                    Secure authentication powered by ASP.NET Core & Google OAuth 2.0
                </small>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function togglePassword() {
            const passwordInput = document.getElementById('passwordInput');
            const toggleIcon = document.getElementById('toggleIcon');

            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.classList.remove('bi-eye');
                toggleIcon.classList.add('bi-eye-slash');
            } else {
                passwordInput.type = 'password';
                toggleIcon.classList.remove('bi-eye-slash');
                toggleIcon.classList.add('bi-eye');
            }
        }
    </script>
}

<style>
    .btn-outline-danger:hover {
        background-color: #dc3545;
        border-color: #dc3545;
        color: white;
    }

    .position-relative hr {
        margin: 0;
    }
</style>