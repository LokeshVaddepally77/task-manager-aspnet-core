@{
    ViewData["Title"] = "Access Denied";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-center mt-5">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow">
                <div class="card-body py-5">
                    <!-- Icon -->
                    <div class="mb-4">
                        <i class="bi bi-shield-lock text-danger" style="font-size: 5rem;"></i>
                    </div>

                    <!-- Title -->
                    <h2 class="text-danger mb-3">Access Denied</h2>

                    <!-- Message -->
                    <p class="text-muted lead mb-4">
                        Sorry, you don't have permission to access this page.
                        This area is restricted to authorized users only.
                    </p>

                    <!-- User Info -->
                    @if (!string.IsNullOrEmpty(Context.Session.GetString("Username")))
                    {
                        <div class="alert alert-light">
                            <small>
                                Logged in as: <strong>@Context.Session.GetString("Username")</strong>
                                <br>
                                Role: <span class="badge bg-secondary">@Context.Session.GetString("Role")</span>
                            </small>
                        </div>
                    }

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 justify-content-center">
                        <a asp-controller="Task" asp-action="Dashboard" class="btn btn-primary">
                            <i class="bi bi-house"></i> Go to Dashboard
                        </a>
                        <a href="javascript:history.back()" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Go Back
                        </a>
                    </div>
                </div>
            </div>

            <!-- Help Text -->
            <div class="mt-4">
                <p class="text-muted small">
                    If you believe you should have access to this page,
                    please contact your system administrator.
                </p>
            </div>
        </div>
    </div>
</div>