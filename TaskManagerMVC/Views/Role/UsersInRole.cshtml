@model TaskManagerMVC.DataAccess.ViewModels.RoleUsersViewModel
@{
    ViewData["Title"] = $"Users in '{Model.RoleName}' Role";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="bi bi-people"></i> Users in
            <span class="badge bg-primary">@Model.RoleName</span> Role
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> Back to Roles
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle"></i> @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Users IN Role -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-check"></i> Users in Role (@Model.UsersInRole.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.UsersInRole.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var user in Model.UsersInRole)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-person-circle text-primary me-2"></i>
                                        <strong>@user.UserName</strong>
                                        <br />
                                        <small class="text-muted">@user.Email</small>
                                    </div>
                                    <form asp-action="RemoveUserFromRole" method="post"
                                          onsubmit="return confirm('Remove this user from @Model.RoleName role?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roleId" value="@Model.RoleId" />
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove from role">
                                            <i class="bi bi-person-dash"></i> Remove
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-person-x" style="font-size: 2rem;"></i>
                            <p class="mt-2">No users in this role</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Users NOT IN Role -->
        <div class="col-md-6 mb-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-secondary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-plus"></i> Available Users (@Model.UsersNotInRole.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (Model.UsersNotInRole.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var user in Model.UsersNotInRole)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <i class="bi bi-person-circle text-secondary me-2"></i>
                                        <strong>@user.UserName</strong>
                                        <span class="badge bg-light text-dark ms-2">@user.Role</span>
                                        <br />
                                        <small class="text-muted">@user.Email</small>
                                    </div>
                                    <form asp-action="AddUserToRole" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roleId" value="@Model.RoleId" />
                                        <input type="hidden" name="userId" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Add to role">
                                            <i class="bi bi-person-plus"></i> Add
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-center py-4 text-muted">
                            <i class="bi bi-people" style="font-size: 2rem;"></i>
                            <p class="mt-2">All users are in this role</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>